rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Put the email(s) that may use /admin below (must match users added under Authentication).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['owner@example.com'];
    }
    // the menu, deals, site details and home images (one document)
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }
    // uploaded photos (each one already shrunk to WebP in the admin panel)
    match /images/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
